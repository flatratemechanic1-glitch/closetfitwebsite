---
// CSS-only auto-sliding testimonial marquee — zero JS for animation
// Infinite loop with pause on hover/focus, glassmorphism cards
import { testimonials } from '@/lib/data/testimonials';
---

<section class="relative py-16 sm:py-24 overflow-hidden" aria-labelledby="testimonials-heading">
  <!-- Section heading -->
  <div class="text-center mb-12 px-4 scroll-reveal">
    <span class="inline-block px-4 py-1.5 glass rounded-full text-xs font-sans uppercase tracking-[0.3em] text-champagne mb-6">
      Testimonials
    </span>
    <h2
      id="testimonials-heading"
      class="text-3xl sm:text-5xl font-display font-bold text-text-primary mb-4"
    >
      Loved by
      <span class="text-lavender">early testers</span>
    </h2>
    <p class="text-text-secondary text-lg max-w-2xl mx-auto">
      Real feedback from people who tried ClosetFit before anyone else.
    </p>
  </div>

  <!-- Gradient fade edges -->
  <div class="absolute left-0 top-0 bottom-0 w-24 sm:w-40 bg-gradient-to-r from-bg to-transparent z-10 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute right-0 top-0 bottom-0 w-24 sm:w-40 bg-gradient-to-l from-bg to-transparent z-10 pointer-events-none" aria-hidden="true"></div>

  <!-- Pause/Play toggle -->
  <div class="text-center mb-6 px-4">
    <button
      id="testimonial-toggle"
      type="button"
      class="inline-flex items-center gap-2 px-4 py-2 glass rounded-full text-xs text-text-secondary hover:text-text-primary transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-champagne"
      aria-label="Pause testimonial carousel"
    >
      <svg id="testimonial-pause-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="6" y="4" width="4" height="16" rx="1" />
        <rect x="14" y="4" width="4" height="16" rx="1" />
      </svg>
      <svg id="testimonial-play-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <polygon points="5,3 19,12 5,21" />
      </svg>
      <span id="testimonial-toggle-text">Pause</span>
    </button>
  </div>

  <!-- Testimonial marquee -->
  <div class="testimonial-container" role="region" aria-label="Customer testimonials" aria-roledescription="carousel">
    <div class="testimonial-track">
      {/* First set */}
      {testimonials.map((t) => (
        <div class="testimonial-card" tabindex="0">
          <div class="glass rounded-2xl p-6 h-full flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-champagne">
            <blockquote class="text-text-secondary text-sm leading-relaxed flex-1 mb-4">
              <span class="text-champagne text-lg font-display leading-none" aria-hidden="true">&ldquo;</span>
              {t.quote}
              <span class="text-champagne text-lg font-display leading-none" aria-hidden="true">&rdquo;</span>
            </blockquote>
            <div class="flex items-center gap-3 mt-auto">
              <div
                class="w-10 h-10 rounded-full flex items-center justify-center text-xs font-bold text-bg flex-shrink-0"
                style={`background: linear-gradient(135deg, var(--color-${t.accent}), var(--color-${t.accent}-light));`}
              >
                {t.initials}
              </div>
              <div>
                <div class="text-text-primary text-sm font-semibold">{t.name}</div>
                <div class="text-text-muted text-xs">{t.role}</div>
              </div>
            </div>
          </div>
        </div>
      ))}
      {/* Duplicate for seamless infinite loop */}
      {testimonials.map((t) => (
        <div class="testimonial-card" aria-hidden="true">
          <div class="glass rounded-2xl p-6 h-full flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-champagne">
            <blockquote class="text-text-secondary text-sm leading-relaxed flex-1 mb-4">
              <span class="text-champagne text-lg font-display leading-none" aria-hidden="true">&ldquo;</span>
              {t.quote}
              <span class="text-champagne text-lg font-display leading-none" aria-hidden="true">&rdquo;</span>
            </blockquote>
            <div class="flex items-center gap-3 mt-auto">
              <div
                class="w-10 h-10 rounded-full flex items-center justify-center text-xs font-bold text-bg flex-shrink-0"
                style={`background: linear-gradient(135deg, var(--color-${t.accent}), var(--color-${t.accent}-light));`}
              >
                {t.initials}
              </div>
              <div>
                <div class="text-text-primary text-sm font-semibold">{t.name}</div>
                <div class="text-text-muted text-xs">{t.role}</div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonial-container {
    width: 100%;
    overflow: hidden;
  }

  .testimonial-track {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: marquee-scroll 50s linear infinite;
  }

  .testimonial-container:hover .testimonial-track,
  .testimonial-container:focus-within .testimonial-track,
  .testimonial-container.is-paused .testimonial-track {
    animation-play-state: paused;
  }

  .testimonial-card {
    flex-shrink: 0;
    width: 320px;
  }

  .testimonial-card:focus-visible {
    outline: 2px solid var(--color-champagne);
    outline-offset: 2px;
    border-radius: 16px;
  }

  @media (min-width: 640px) {
    .testimonial-card {
      width: 380px;
    }
  }
</style>

<script is:inline>
  (function () {
    function initToggle() {
      var btn = document.getElementById('testimonial-toggle');
      var container = document.querySelector('.testimonial-container');
      var pauseIcon = document.getElementById('testimonial-pause-icon');
      var playIcon = document.getElementById('testimonial-play-icon');
      var toggleText = document.getElementById('testimonial-toggle-text');

      if (!btn || !container) return;

      var paused = false;

      btn.addEventListener('click', function () {
        paused = !paused;
        container.classList.toggle('is-paused', paused);
        pauseIcon.classList.toggle('hidden', paused);
        playIcon.classList.toggle('hidden', !paused);
        toggleText.textContent = paused ? 'Play' : 'Pause';
        btn.setAttribute('aria-label', paused ? 'Play testimonial carousel' : 'Pause testimonial carousel');
      });
    }

    initToggle();
    document.addEventListener('astro:after-swap', initToggle);
  })();
</script>
