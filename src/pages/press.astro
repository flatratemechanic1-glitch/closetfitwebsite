---
import PageLayout from '../layouts/PageLayout.astro';
import { organizationSchema, breadcrumbSchema } from '../lib/schema';

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: 'Home', url: 'https://closetfitapp.com/' },
    { name: 'Press', url: 'https://closetfitapp.com/press/' },
  ]),
];

const companyFacts = [
  { label: 'Founded', value: '2025' },
  { label: 'Headquarters', value: 'San Francisco, CA' },
  { label: 'Team Size', value: '12 people' },
  { label: 'Stage', value: 'Private Beta' },
  { label: 'Platforms', value: 'iOS & Android' },
  { label: 'Category', value: 'AI / Fashion Tech' },
];

const brandAssets = [
  { name: 'Logo — Dark', description: 'Primary logo on dark backgrounds', format: 'SVG, PNG' },
  { name: 'Logo — Light', description: 'For light backgrounds and print', format: 'SVG, PNG' },
  { name: 'Icon Mark', description: 'App icon and square format', format: 'SVG, PNG' },
  { name: 'Brand Guidelines', description: 'Colors, typography, usage rules', format: 'PDF' },
];
---

<PageLayout
  title="Press Kit — ClosetFitApp"
  description="Press resources for ClosetFitApp. Download brand assets, company facts, and media contact information for press coverage."
  heading="Press & Media"
  subheading="Everything you need to write about ClosetFitApp. Brand assets, company facts, and media contacts."
  schema={schema}
>
  <!-- Company Overview -->
  <section class="relative py-12 sm:py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1.5 glass rounded-full text-xs font-sans uppercase tracking-[0.3em] text-champagne mb-6">
        About ClosetFit
      </span>
      <div class="glass rounded-2xl p-8 sm:p-10">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-text-primary mb-6">Company Overview</h2>
        <div class="space-y-4 text-text-secondary leading-relaxed">
          <p>
            ClosetFitApp is an AI-powered wardrobe management and virtual try-on platform that helps people make the most of their existing clothing. Using advanced computer vision and style-matching algorithms, the app catalogs your wardrobe, suggests outfits, and lets you see how they look — before you get dressed.
          </p>
          <p>
            Founded in 2025, ClosetFitApp is currently in private beta with plans to launch publicly on iOS and Android in early 2026. The company is headquartered in San Francisco and backed by a team of fashion tech entrepreneurs, AI researchers, and product designers.
          </p>
        </div>

        <!-- Boilerplate -->
        <div class="mt-8 pt-8 border-t border-border">
          <h3 class="text-sm font-sans uppercase tracking-[0.2em] text-text-muted mb-3">Boilerplate</h3>
          <p class="text-text-secondary text-sm leading-relaxed italic">
            "ClosetFitApp is an AI-powered wardrobe management app that helps people see themselves in any outfit, digitally. By combining virtual try-on technology with smart outfit suggestions, ClosetFitApp makes it easy to wear more of what you own and dress with confidence every day."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Facts -->
  <section class="relative py-12 sm:py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1.5 glass rounded-full text-xs font-sans uppercase tracking-[0.3em] text-champagne mb-6">
        Quick Facts
      </span>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        {companyFacts.map((fact) => (
          <div class="glass rounded-xl p-5 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-champagne">
            <div class="text-text-muted text-xs font-sans uppercase tracking-[0.2em] mb-2">{fact.label}</div>
            <div class="text-text-primary font-display font-semibold text-lg">{fact.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand Assets -->
  <section class="relative py-12 sm:py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1.5 glass rounded-full text-xs font-sans uppercase tracking-[0.3em] text-lavender mb-6">
        Brand Assets
      </span>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-text-primary mb-8">
        Download
        <span class="bg-gradient-to-r from-champagne to-lavender bg-clip-text text-transparent">
          brand assets
        </span>
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {brandAssets.map((asset) => (
          <div class="glass rounded-xl p-6 flex items-center gap-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-champagne group">
            <div class="shrink-0 w-12 h-12 rounded-lg bg-surface-solid border border-border flex items-center justify-center text-champagne" aria-hidden="true">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-display font-semibold text-text-primary text-sm">{asset.name}</h3>
              <p class="text-text-muted text-xs mt-0.5">{asset.description}</p>
            </div>
            <span class="text-xs font-mono text-text-muted uppercase tracking-wider shrink-0">{asset.format}</span>
          </div>
        ))}
      </div>

      <p class="text-text-muted text-sm mt-6 text-center">
        Brand assets will be available for download closer to public launch. In the meantime, contact us for any immediate press needs.
      </p>
    </div>
  </section>

  <!-- Press Releases -->
  <section class="relative py-12 sm:py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1.5 glass rounded-full text-xs font-sans uppercase tracking-[0.3em] text-champagne mb-6">
        Press Releases
      </span>
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-text-primary mb-8">Latest news</h2>

      <div class="glass rounded-xl p-8 text-center">
        <svg class="w-12 h-12 text-text-muted mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <h3 class="font-display font-semibold text-text-primary mb-2">Press releases coming soon</h3>
        <p class="text-text-secondary text-sm">We will share launch announcements and company news here. Subscribe to be notified.</p>
      </div>
    </div>
  </section>

  <!-- Media Contact -->
  <section class="relative py-12 sm:py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <span class="inline-block px-4 py-1.5 glass rounded-full text-xs font-sans uppercase tracking-[0.3em] text-coral mb-6">
        Contact
      </span>
      <div class="glass rounded-2xl p-8 sm:p-10">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-text-primary mb-6">Media Contact</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
          <div>
            <h3 class="text-sm font-sans uppercase tracking-[0.2em] text-text-muted mb-3">Press Inquiries</h3>
            <div class="space-y-2">
              <a href="mailto:press@closetfitapp.com" class="text-champagne hover:text-champagne-light transition-colors duration-200 block">
                press@closetfitapp.com
              </a>
              <p class="text-text-muted text-sm">We typically respond within 24 hours.</p>
            </div>
          </div>
          <div>
            <h3 class="text-sm font-sans uppercase tracking-[0.2em] text-text-muted mb-3">General Inquiries</h3>
            <div class="space-y-2">
              <a href="mailto:hello@closetfitapp.com" class="text-champagne hover:text-champagne-light transition-colors duration-200 block">
                hello@closetfitapp.com
              </a>
              <p class="text-text-muted text-sm">For partnerships, collaborations, and other inquiries.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
