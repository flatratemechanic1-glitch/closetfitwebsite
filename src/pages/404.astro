---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found — ClosetFitApp"
  description="The page you are looking for does not exist."
  noindex={true}
>
  <section class="relative min-h-[calc(100vh-8rem)] flex items-center justify-center px-4 overflow-hidden">
    <!-- Aurora gradient mesh -->
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(ellipse 800px 800px at 30% 40%, rgba(78, 42, 107, 0.4) 0%, transparent 70%),
        radial-gradient(ellipse 700px 700px at 70% 50%, rgba(46, 46, 120, 0.3) 0%, transparent 70%),
        radial-gradient(ellipse 600px 600px at 50% 70%, rgba(201, 168, 124, 0.2) 0%, transparent 70%),
        #09090B;"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 text-center max-w-lg mx-auto">
      <!-- Large 404 -->
      <h1
        class="text-[8rem] sm:text-[12rem] font-display font-bold leading-none mb-4 bg-gradient-to-r from-champagne to-lavender bg-clip-text text-transparent"
      >
        404
      </h1>

      <h2 class="text-2xl sm:text-3xl font-display font-semibold text-text-primary mb-4">
        Page not found
      </h2>

      <p class="text-text-secondary text-lg mb-10 leading-relaxed">
        The page you're looking for may have been moved or doesn't exist.
      </p>

      <a
        href="/"
        class="inline-block px-8 py-3.5 bg-coral text-bg font-bold rounded-xl transition-all duration-200 hover:brightness-110 hover:-translate-y-0.5 hover:shadow-glow-coral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral min-h-[44px]"
      >
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>
