---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScreenshotCarousel from '../components/home/ScreenshotCarousel.astro';
import ProblemSection from '../components/home/ProblemSection.astro';
import Hero3DPhone from '../components/home/Hero3DPhone.tsx';
import MagneticButton from '../components/ui/MagneticButton.tsx';
import HowItWorks from '../components/home/HowItWorks.tsx';
import FeaturesSection from '../components/home/FeaturesSection.astro';
import PricingSection from '../components/home/PricingSection.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import FAQSection from '../components/home/FAQSection.astro';
import FinalCTA from '../components/home/FinalCTA.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ClosetFitApp',
  url: 'https://closetfitapp.com',
  description: 'AI-powered virtual try-on and wardrobe app. See yourself in any outfit, digitally.',
};

const heroScreenshots = [
  '/screenshots/01.png',
  '/screenshots/02.png',
  '/screenshots/03.png',
  '/screenshots/04.png',
  '/screenshots/05.png',
  '/screenshots/06.png',
  '/screenshots/07.png',
  '/screenshots/08.png',
];

const howItWorksSteps = [
  {
    label: 'Step 1',
    title: 'Photograph',
    description: 'Snap photos of your clothes with your phone camera. Our AI instantly recognizes each item, categorizes it, and builds your digital wardrobe in seconds.',
    image: '/screenshots/01.png',
  },
  {
    label: 'Step 2',
    title: 'AI Organizes',
    description: 'Our AI catalogs every piece by type, color, season, and style. It learns your preferences and identifies gaps in your wardrobe so you shop smarter.',
    image: '/screenshots/04.png',
  },
  {
    label: 'Step 3',
    title: 'Get Daily Outfits',
    description: 'Each morning, get personalized outfit suggestions based on your schedule, the weather, and your personal style. See yourself wearing them — virtually.',
    image: '/screenshots/05.png',
  },
];
---

<BaseLayout
  title="ClosetFitApp — Virtual Try-On & AI Wardrobe"
  description="ClosetFitApp lets you see yourself wearing any outfit from your closet, digitally. AI-powered virtual try-on and wardrobe management. Coming soon."
  schema={schema}
>
  <!-- ============================================
       HERO SECTION
       Aurora gradient mesh + 2-column layout
       ============================================ -->
  <section id="hero" class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden px-4">
    <!-- Aurora gradient mesh background -->
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(ellipse 800px 800px at 20% 30%, #4E2A6B 0%, transparent 70%),
        radial-gradient(ellipse 700px 700px at 75% 60%, #2E2E78 0%, transparent 70%),
        radial-gradient(ellipse 600px 600px at 50% 80%, rgba(201, 168, 124, 0.30) 0%, transparent 70%),
        #09090B;
        background-size: 200% 200%;
        animation: aurora-drift 20s ease-in-out infinite;"
      aria-hidden="true"
    ></div>

    <!-- Subtle grain texture overlay -->
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27n%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23n)%27/%3E%3C/svg%3E');"
      aria-hidden="true"
    ></div>

    <!-- Mouse-following spotlight overlay -->
    <div
      id="hero-spotlight"
      class="absolute pointer-events-none opacity-0 transition-opacity duration-500"
      style="
        width: 1200px;
        height: 1200px;
        background: radial-gradient(
          ellipse 600px 600px at center,
          rgba(201, 168, 124, 0.15) 0%,
          rgba(167, 139, 250, 0.06) 30%,
          transparent 70%
        );
        will-change: transform;
        top: 0;
        left: 0;
      "
      aria-hidden="true"
    ></div>

    <!-- Hero content — 2-column layout on desktop -->
    <div class="relative z-10 w-full max-w-7xl mx-auto flex flex-col lg:flex-row items-center gap-8 lg:gap-12 py-16 sm:py-20">
      <!-- Left column: Text content -->
      <div class="flex-1 text-center lg:text-left">
        <!-- Brand tagline -->
        <div class="mb-8 animate-[fade-up_0.6s_ease-out_both]">
          <span class="inline-block px-4 py-1.5 glass rounded-full text-xs font-sans uppercase tracking-[0.3em] text-champagne">
            Closet Fit
          </span>
        </div>

        <!-- Headline — Clash Display -->
        <h1
          class="text-5xl sm:text-7xl lg:text-8xl font-display font-bold tracking-tight text-text-primary mb-6 animate-[fade-up_0.6s_ease-out_0.1s_both] leading-[1.05]"
        >
          Try It On
          <br />
          <span class="bg-gradient-to-r from-champagne to-lavender bg-clip-text text-transparent">Without Putting It On</span>
        </h1>

        <!-- Subheadline -->
        <p
          class="text-lg sm:text-xl text-text-secondary max-w-xl mx-auto lg:mx-0 mb-10 animate-[fade-up_0.6s_ease-out_0.2s_both] leading-relaxed"
        >
          See yourself wearing any outfit from your closet &mdash; digitally.
          AI-powered virtual try-on that helps you dress smarter without the hassle.
        </p>

        <!-- Email Capture Form with Magnetic CTA -->
        <div class="animate-[fade-up_0.6s_ease-out_0.3s_both]">
          <form
            class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto lg:mx-0"
            action="#"
            method="POST"
          >
            <input
              type="email"
              name="email"
              placeholder="Enter your email"
              required
              class="flex-1 px-4 py-3 glass rounded-xl text-text-primary placeholder-text-muted focus:outline-none focus:border-champagne focus:ring-1 focus:ring-champagne transition-colors min-h-[44px] bg-transparent"
            />
            <MagneticButton client:visible>
              <button
                type="submit"
                class="px-6 py-3 bg-coral text-bg font-semibold rounded-xl transition-all duration-200 hover:bg-coral-light hover:-translate-y-0.5 hover:shadow-glow-coral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral min-h-[44px] animate-[glow-pulse_3s_ease-in-out_infinite] whitespace-nowrap w-full sm:w-auto"
              >
                Get Early Access
              </button>
            </MagneticButton>
          </form>
          <p class="text-sm text-text-muted mt-3">
            Join the waitlist. No spam, ever.
          </p>
        </div>

        <!-- Feature Highlights — Glass cards -->
        <div
          class="mt-12 lg:mt-16 grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 text-left animate-[fade-up_0.6s_ease-out_0.5s_both]"
        >
          <div class="p-5 glass rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-champagne">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center glass text-champagne mb-2" aria-hidden="true">
              <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1.5"/><path d="M17.5 7h.01"/></svg>
            </div>
            <h3 class="font-display font-semibold text-text-primary text-sm">Snap Your Closet</h3>
            <p class="text-text-muted text-sm mt-1">
              Photograph your clothes. AI catalogs and organizes everything in seconds.
            </p>
          </div>
          <div class="p-5 glass rounded-xl border-l-2 border-l-lavender transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-lavender">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center glass text-lavender mb-2" aria-hidden="true">
              <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l-4 4h3v5h2V7h3l-4-4z"/><path d="M8 11c-3 0-5 2-5 5v2h18v-2c0-3-2-5-5-5"/><path d="M6 18v3h12v-3"/><path d="M19 4l.8-.8M19 4l-.8-.8M21 6h-1.2"/></svg>
            </div>
            <h3 class="font-display font-semibold text-text-primary text-sm">Virtual Try-On</h3>
            <p class="text-text-muted text-sm mt-1">
              See yourself wearing any outfit on screen. No changing room needed.
            </p>
          </div>
          <div class="p-5 glass rounded-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-champagne">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center glass text-champagne mb-2" aria-hidden="true">
              <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.5 3.2 3.5.5-2.5 2.4.6 3.5L12 11l-3.1 1.6.6-3.5L7 6.7l3.5-.5L12 3z"/><path d="M5 16l.8 1.7 1.8.3-1.3 1.3.3 1.8L5 20.2l-1.6.9.3-1.8L2.4 18l1.8-.3L5 16z"/><path d="M19 14l.6 1.2 1.3.2-.9.9.2 1.3-1.2-.6-1.2.6.2-1.3-.9-.9 1.3-.2L19 14z"/></svg>
            </div>
            <h3 class="font-display font-semibold text-text-primary text-sm">Styled Daily</h3>
            <p class="text-text-muted text-sm mt-1">
              AI picks outfits based on weather, calendar, and your style. Get dressed in seconds.
            </p>
          </div>
        </div>
      </div>

      <!-- Right column: 3D Phone Mockup (hidden on small mobile) -->
      <div class="hidden sm:block flex-shrink-0 w-full sm:w-auto lg:w-[400px] xl:w-[480px] animate-[fade-up_0.6s_ease-out_0.4s_both]">
        <Hero3DPhone client:visible screenshots={heroScreenshots} />
      </div>
    </div>

    <!-- Ambient floating particles — champagne/lavender -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute w-2 h-2 bg-champagne/20 rounded-full animate-[float_6s_ease-in-out_infinite]" style="top: 20%; left: 10%;"></div>
      <div class="absolute w-1 h-1 bg-lavender/15 rounded-full animate-[float_8s_ease-in-out_1s_infinite]" style="top: 60%; left: 80%;"></div>
      <div class="absolute w-1.5 h-1.5 bg-champagne/15 rounded-full animate-[float_7s_ease-in-out_2s_infinite]" style="top: 40%; left: 60%;"></div>
      <div class="absolute w-1 h-1 bg-lavender/10 rounded-full animate-[float_9s_ease-in-out_0.5s_infinite]" style="top: 80%; left: 25%;"></div>
      <div class="absolute w-2 h-2 bg-champagne/10 rounded-full animate-[float_7s_ease-in-out_3s_infinite]" style="top: 15%; left: 75%;"></div>
      <div class="absolute w-1.5 h-1.5 bg-coral/10 rounded-full animate-[float_8s_ease-in-out_4s_infinite]" style="top: 70%; left: 40%;"></div>
    </div>
  </section>

  <!-- Hero spotlight mouse-tracking script -->
  <script is:inline>
    (function() {
      function initSpotlight() {
        var section = document.getElementById('hero');
        var spotlight = document.getElementById('hero-spotlight');

        if (!section || !spotlight) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var rafId = 0;
        var targetX = 0;
        var targetY = 0;
        var currentX = 0;
        var currentY = 0;

        function lerp(a, b, t) {
          return a + (b - a) * t;
        }

        function animate() {
          currentX = lerp(currentX, targetX, 0.08);
          currentY = lerp(currentY, targetY, 0.08);

          spotlight.style.transform = 'translate(' + (currentX - 600) + 'px,' + (currentY - 600) + 'px)';

          rafId = requestAnimationFrame(animate);
        }

        function onMouseMove(e) {
          var rect = section.getBoundingClientRect();
          targetX = e.clientX - rect.left;
          targetY = e.clientY - rect.top;
        }

        function onMouseEnter(e) {
          var rect = section.getBoundingClientRect();
          currentX = e.clientX - rect.left;
          currentY = e.clientY - rect.top;
          targetX = currentX;
          targetY = currentY;
          spotlight.style.opacity = '1';
          rafId = requestAnimationFrame(animate);
        }

        function onMouseLeave() {
          spotlight.style.opacity = '0';
          cancelAnimationFrame(rafId);
        }

        section.addEventListener('mousemove', onMouseMove, { passive: true });
        section.addEventListener('mouseenter', onMouseEnter);
        section.addEventListener('mouseleave', onMouseLeave);

        return function() {
          cancelAnimationFrame(rafId);
          section.removeEventListener('mousemove', onMouseMove);
          section.removeEventListener('mouseenter', onMouseEnter);
          section.removeEventListener('mouseleave', onMouseLeave);
        };
      }

      var cleanup = initSpotlight();

      document.addEventListener('astro:before-swap', function() {
        if (cleanup) cleanup();
      });

      document.addEventListener('astro:after-swap', function() {
        cleanup = initSpotlight();
      });
    })();
  </script>

  <!-- ============================================
       SCREENSHOT CAROUSEL
       Auto-scrolling app preview
       ============================================ -->
  <ScreenshotCarousel />

  <!-- ============================================
       THE PROBLEM SECTION
       Animated stats with count-up
       ============================================ -->
  <ProblemSection />

  <!-- ============================================
       HOW IT WORKS
       GSAP ScrollTrigger pinned timeline
       ============================================ -->
  <HowItWorks client:visible steps={howItWorksSteps} />

  <!-- ============================================
       FEATURES SECTION
       6-card grid with Motion stagger reveals
       ============================================ -->
  <FeaturesSection />

  <!-- ============================================
       PRICING SECTION
       3-plan comparison with monthly/annual toggle
       ============================================ -->
  <PricingSection />

  <!-- ============================================
       TESTIMONIALS SECTION
       CSS-only auto-sliding marquee
       ============================================ -->
  <TestimonialsSection />

  <!-- ============================================
       FAQ SECTION
       Accordion with FAQPage JSON-LD schema
       ============================================ -->
  <FAQSection />

  <!-- ============================================
       FINAL CTA SECTION
       Aurora gradient + email capture
       ============================================ -->
  <FinalCTA />

</BaseLayout>
