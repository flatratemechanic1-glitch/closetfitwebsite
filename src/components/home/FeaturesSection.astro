---
import FeatureCards from './FeatureCards.tsx';
import ScreenshotCarousel from './ScreenshotCarousel.astro';

const features = [
  {
    title: 'Smart Cataloging',
    description: 'Snap a photo of any clothing item and our system instantly recognizes it, categorizes by type, color, season, and occasion, and adds it to your digital wardrobe.',
    iconKey: 'smart-cataloging',
    isAI: false,
  },
  {
    title: 'AI Outfit Suggestions',
    description: 'Get personalized outfit recommendations based on your style preferences, schedule, and what is already in your closet. Never repeat the same look twice.',
    iconKey: 'ai-outfit',
    isAI: true,
  },
  {
    title: 'Weather-Based Styling',
    description: 'Our AI checks the forecast and suggests outfits that match the weather ahead. Rain, shine, or snow — you will always be dressed for the day.',
    iconKey: 'weather',
    isAI: true,
  },
  {
    title: 'Wardrobe Analytics',
    description: 'See which clothes you wear most, which are gathering dust, and how much your wardrobe is really worth. Data-driven insights for smarter shopping.',
    iconKey: 'analytics',
    isAI: false,
  },
  {
    title: 'Capsule Builder',
    description: 'Build versatile capsule wardrobes from your existing clothes. Create travel packs, seasonal capsules, or minimalist collections with maximum outfit combinations.',
    iconKey: 'capsule',
    isAI: false,
  },
  {
    title: 'Style Calendar',
    description: 'Plan your outfits for the entire week ahead. Sync with your calendar so you are always dressed appropriately for meetings, dates, workouts, and everything in between.',
    iconKey: 'calendar',
    isAI: false,
  },
];
---

<section class="relative py-16 sm:py-24 px-4" aria-labelledby="features-heading">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-12 sm:mb-16 scroll-reveal">
      <span class="inline-block px-4 py-1.5 glass rounded-full text-xs font-sans uppercase tracking-[0.3em] text-champagne mb-6">
        Features
      </span>
      <h2
        id="features-heading"
        class="text-3xl sm:text-5xl font-display font-bold text-text-primary mb-4"
      >
        Everything you need to
        <span class="bg-gradient-to-r from-champagne to-lavender bg-clip-text text-transparent">
          dress smarter
        </span>
      </h2>
      <p class="text-text-secondary text-lg max-w-2xl mx-auto">
        From AI-powered outfit suggestions to wardrobe analytics, ClosetFit turns your closet into your personal stylist.
      </p>
    </div>

    <!-- Feature cards grid -->
    <FeatureCards client:visible features={features} />
  </div>

  <!-- Screenshot carousel below features -->
  <div class="mt-16 sm:mt-24">
    <ScreenshotCarousel />
  </div>
</section>
