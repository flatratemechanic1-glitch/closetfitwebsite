---
import { ClientRouter } from 'astro:transitions';
import SEOHead from '../components/global/SEOHead.astro';
import ScrollProgress from '../components/global/ScrollProgress.astro';
import Navigation from '../components/global/Navigation.astro';
import Footer from '../components/global/Footer.astro';
import BorderTracer from '../components/global/BorderTracer.astro';
import '../styles/global.css';
import '../styles/animations.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  schema?: object | object[];
  noindex?: boolean;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author: string;
    section: string;
    tags: string[];
  };
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <SEOHead {...props} />
    <!-- Self-hosted fonts — preload critical weights -->
    <link rel="preload" href="/fonts/clash-display-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body class="bg-bg text-text-primary antialiased min-h-screen font-sans">
    <BorderTracer />
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-champagne focus:text-bg focus:rounded-md"
    >
      Skip to content
    </a>
    <ScrollProgress />
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      // Clean up GSAP ScrollTrigger instances before Astro view transitions
      document.addEventListener('astro:before-swap', () => {
        // @ts-ignore — GSAP may not be loaded on every page
        if (typeof ScrollTrigger !== 'undefined') {
          // @ts-ignore
          ScrollTrigger.getAll().forEach((t: any) => t.kill());
        }
      });
    </script>
  </body>
</html>
