---
// Sticky navigation with blur backdrop, shrink-on-scroll, and mobile menu
// Zero-JS for rendering; inline <script> for scroll behavior + mobile toggle
---

<header>
  <nav
    id="main-nav"
    class="fixed top-0 left-0 right-0 z-30 backdrop-blur-xl bg-bg/80 border-b border-border transition-all duration-300"
    aria-label="Main navigation"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between transition-all duration-300">
      <!-- Logo -->
      <a
        href="/"
        class="text-xl font-display font-bold text-text-primary hover:text-champagne transition-colors duration-200"
      >
        ClosetFit
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        <a
          href="/features"
          class="text-text-secondary hover:text-champagne transition-colors duration-200 text-sm font-medium"
        >
          Features
        </a>
        <a
          href="/pricing"
          class="text-text-secondary hover:text-champagne transition-colors duration-200 text-sm font-medium"
        >
          Pricing
        </a>
        <a
          href="/download"
          class="text-text-secondary hover:text-champagne transition-colors duration-200 text-sm font-medium"
        >
          Download
        </a>
        <a
          href="/waitlist"
          class="inline-flex items-center justify-center px-4 py-2 bg-coral text-bg font-semibold rounded-xl hover:bg-coral-light hover:-translate-y-0.5 hover:shadow-glow-coral transition-all duration-200 min-h-[44px] text-sm"
        >
          Join Waitlist
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-11 h-11 min-h-[44px] min-w-[44px] text-text-primary"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="menu-icon-open"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          id="menu-icon-close"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="md:hidden hidden border-t border-border bg-bg/95 backdrop-blur-xl"
    >
      <div class="px-4 py-6 space-y-4">
        <a
          href="/features"
          class="block text-text-secondary hover:text-champagne transition-colors duration-200 font-medium min-h-[44px] flex items-center"
        >
          Features
        </a>
        <a
          href="/pricing"
          class="block text-text-secondary hover:text-champagne transition-colors duration-200 font-medium min-h-[44px] flex items-center"
        >
          Pricing
        </a>
        <a
          href="/download"
          class="block text-text-secondary hover:text-champagne transition-colors duration-200 font-medium min-h-[44px] flex items-center"
        >
          Download
        </a>
        <a
          href="/waitlist"
          class="inline-flex items-center justify-center w-full px-4 py-3 bg-coral text-bg font-semibold rounded-xl hover:bg-coral-light transition-colors duration-200 min-h-[44px] text-center"
        >
          Join Waitlist
        </a>
      </div>
    </div>
  </nav>

  <!-- Spacer to prevent content from hiding under fixed nav -->
  <div class="h-16"></div>
</header>

<script>
  function initNav() {
    const nav = document.getElementById('main-nav');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!nav || !menuBtn || !mobileMenu || !iconOpen || !iconClose) return;

    // Mobile menu toggle
    menuBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', String(isOpen));
    });

    // Close mobile menu when a link is clicked
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });

    // Shrink nav on scroll
    const handleScroll = () => {
      if (window.scrollY > 50) {
        nav.classList.add('nav-scrolled');
      } else {
        nav.classList.remove('nav-scrolled');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
  }

  // Initialize on page load
  initNav();

  // Re-initialize after Astro view transitions
  document.addEventListener('astro:after-swap', initNav);
</script>

<style>
  /* Shrunk state on scroll */
  .nav-scrolled {
    border-bottom-color: rgba(255, 255, 255, 0.12);
  }

  .nav-scrolled > div {
    height: 3.5rem; /* 56px, from 64px */
  }

  .nav-scrolled a:first-child {
    font-size: 1.125rem; /* slightly smaller logo */
  }
</style>
