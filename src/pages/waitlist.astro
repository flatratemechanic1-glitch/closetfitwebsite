---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organizationSchema, breadcrumbSchema } from '../lib/schema';

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: 'Home', url: 'https://closetfitapp.com/' },
    { name: 'Join Waitlist', url: 'https://closetfitapp.com/waitlist/' },
  ]),
];

const benefits = [
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    text: 'Early access before the public launch',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/></svg>`,
    text: 'Exclusive founding member pricing',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`,
    text: 'Direct input on features we build',
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    text: 'Priority support and onboarding',
  },
];
---

<BaseLayout
  title="Join the Waitlist — ClosetFitApp"
  description="Be among the first to try ClosetFitApp. Join 1,200+ people on the waitlist for early access to AI-powered virtual try-on and wardrobe management."
  schema={schema}
>
  <!-- Full-screen aurora background -->
  <section class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center px-4 py-20 overflow-hidden">
    <!-- Aurora gradient mesh -->
    <div
      class="absolute inset-0"
      style="background:
        radial-gradient(ellipse 800px 800px at 20% 30%, rgba(78, 42, 107, 0.5) 0%, transparent 70%),
        radial-gradient(ellipse 700px 700px at 75% 60%, rgba(46, 46, 120, 0.4) 0%, transparent 70%),
        radial-gradient(ellipse 600px 600px at 50% 80%, rgba(201, 168, 124, 0.25) 0%, transparent 70%),
        #09090B;"
      aria-hidden="true"
    ></div>

    <!-- Floating ambient orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-lavender/5 rounded-full blur-3xl animate-[pulse_8s_ease-in-out_infinite]" aria-hidden="true"></div>
    <div class="absolute bottom-1/3 right-1/4 w-80 h-80 bg-coral/5 rounded-full blur-3xl animate-[pulse_10s_ease-in-out_infinite_2s]" aria-hidden="true"></div>

    <div class="relative z-10 max-w-2xl mx-auto text-center">
      <!-- Social proof counter -->
      <div class="inline-flex items-center gap-2 px-5 py-2.5 glass-strong rounded-full mb-8">
        <div class="flex -space-x-2" aria-hidden="true">
          <div class="w-6 h-6 rounded-full bg-gradient-to-br from-champagne to-champagne-light border-2 border-bg"></div>
          <div class="w-6 h-6 rounded-full bg-gradient-to-br from-lavender to-lavender-light border-2 border-bg"></div>
          <div class="w-6 h-6 rounded-full bg-gradient-to-br from-coral to-coral-light border-2 border-bg"></div>
        </div>
        <span class="text-sm font-medium text-text-primary">
          <span class="text-champagne font-bold">1,200+</span> people on the waitlist
        </span>
      </div>

      <!-- Heading -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-display font-bold text-text-primary mb-6 leading-[1.1]">
        Be the first to
        <span class="bg-gradient-to-r from-champagne via-lavender to-coral bg-clip-text text-transparent">
          try it on
        </span>
      </h1>
      <p class="text-lg sm:text-xl text-text-secondary max-w-lg mx-auto mb-10 leading-relaxed">
        Join the waitlist for early access to AI-powered virtual try-on and smart wardrobe management.
      </p>

      <!-- Email Form -->
      <form class="max-w-md mx-auto mb-12" action="#" method="POST">
        <div class="flex flex-col sm:flex-row gap-3">
          <label for="waitlist-email" class="sr-only">Email address</label>
          <input
            type="email"
            id="waitlist-email"
            name="email"
            required
            placeholder="you@email.com"
            class="flex-1 px-5 py-3.5 bg-surface-solid border border-border rounded-xl text-text-primary placeholder:text-text-muted focus:outline-none focus:border-champagne focus:ring-1 focus:ring-champagne transition-colors duration-200 min-h-[44px]"
            autocomplete="email"
          />
          <button
            type="submit"
            class="px-6 py-3.5 bg-coral text-bg font-bold rounded-xl transition-all duration-200 hover:bg-coral-light hover:-translate-y-0.5 hover:shadow-glow-coral focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral min-h-[44px] whitespace-nowrap"
          >
            Join Waitlist
          </button>
        </div>
        <p class="text-text-muted text-xs mt-3">
          No spam. Unsubscribe anytime. Read our <a href="/privacy" class="text-champagne hover:text-champagne-light transition-colors underline">privacy policy</a>.
        </p>
      </form>

      <!-- Benefits List -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-lg mx-auto">
        {benefits.map((benefit) => (
          <div class="flex items-center gap-3 text-left">
            <div class="shrink-0 w-9 h-9 rounded-lg glass flex items-center justify-center text-champagne" aria-hidden="true" set:html={benefit.icon} />
            <span class="text-sm text-text-secondary">{benefit.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What You'll Get -->
  <section class="relative py-16 sm:py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 glass rounded-full text-xs font-sans uppercase tracking-[0.3em] text-champagne mb-6">
          What You'll Get
        </span>
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-text-primary mb-4">
          More than just an
          <span class="bg-gradient-to-r from-champagne to-lavender bg-clip-text text-transparent">
            outfit app
          </span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="glass rounded-xl p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-champagne">
          <div class="text-4xl mb-4" aria-hidden="true">
            <svg class="w-10 h-10 mx-auto text-champagne" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="font-display font-semibold text-text-primary mb-2">Snap & Catalog</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Photograph your clothes and our AI instantly catalogs them by type, color, and style.</p>
        </div>

        <div class="glass rounded-xl p-6 text-center border-l-2 border-l-lavender transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-lavender">
          <div class="text-4xl mb-4" aria-hidden="true">
            <svg class="w-10 h-10 mx-auto text-lavender" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <span class="text-xs font-mono text-lavender uppercase tracking-wider">AI Feature</span>
          <h3 class="font-display font-semibold text-text-primary mb-2 mt-1">Virtual Try-On</h3>
          <p class="text-text-secondary text-sm leading-relaxed">See how outfits look on you before getting dressed. Mix and match effortlessly.</p>
        </div>

        <div class="glass rounded-xl p-6 text-center transition-all duration-300 hover:-translate-y-1 hover:shadow-glow-champagne">
          <div class="text-4xl mb-4" aria-hidden="true">
            <svg class="w-10 h-10 mx-auto text-champagne" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
          </div>
          <h3 class="font-display font-semibold text-text-primary mb-2">Daily Outfits</h3>
          <p class="text-text-secondary text-sm leading-relaxed">Get personalized outfit suggestions every day based on weather, calendar, and your style.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
