---
// Auto-scrolling screenshot marquee — CSS-only, zero JS
// Infinite loop with pause on hover
const screenshots = [
  { src: '/screenshots/01.png', alt: 'ClosetFit app — wardrobe overview screen' },
  { src: '/screenshots/02.png', alt: 'ClosetFit app — outfit suggestions screen' },
  { src: '/screenshots/03.png', alt: 'ClosetFit app — AI styling screen' },
  { src: '/screenshots/04.png', alt: 'ClosetFit app — clothing catalog screen' },
  { src: '/screenshots/05.png', alt: 'ClosetFit app — daily outfit screen' },
  { src: '/screenshots/06.png', alt: 'ClosetFit app — style analysis screen' },
  { src: '/screenshots/07.png', alt: 'ClosetFit app — wardrobe stats screen' },
  { src: '/screenshots/08.png', alt: 'ClosetFit app — outfit calendar screen' },
];
---

<section class="relative py-16 sm:py-24 overflow-hidden">
  <!-- Section heading -->
  <div class="text-center mb-12 px-4">
    <p class="text-xs font-sans uppercase tracking-[0.3em] text-champagne mb-4 animate-[fade-up_0.6s_ease-out_both]">
      See It In Action
    </p>
    <h2 class="text-3xl sm:text-5xl font-display font-semibold text-text-primary animate-[fade-up_0.6s_ease-out_0.1s_both]">
      Your Closet, <span class="text-lavender">Reimagined</span>
    </h2>
  </div>

  <!-- Gradient fade edges -->
  <div class="absolute left-0 top-0 bottom-0 w-24 sm:w-40 bg-gradient-to-r from-bg to-transparent z-10 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute right-0 top-0 bottom-0 w-24 sm:w-40 bg-gradient-to-l from-bg to-transparent z-10 pointer-events-none" aria-hidden="true"></div>

  <!-- Marquee track -->
  <div class="marquee-container group">
    <div class="marquee-track">
      {/* First set of screenshots */}
      {screenshots.map((shot) => (
        <div class="marquee-item">
          <div class="phone-frame glass rounded-[32px] overflow-hidden shadow-lg transition-all duration-300 hover:shadow-glow-champagne hover:-translate-y-1">
            <img
              src={shot.src}
              alt={shot.alt}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      ))}
      {/* Duplicate for seamless infinite loop */}
      {screenshots.map((shot) => (
        <div class="marquee-item" aria-hidden="true">
          <div class="phone-frame glass rounded-[32px] overflow-hidden shadow-lg transition-all duration-300 hover:shadow-glow-champagne hover:-translate-y-1">
            <img
              src={shot.src}
              alt=""
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee-container {
    width: 100%;
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    gap: 24px;
    width: max-content;
    animation: marquee-scroll 40s linear infinite;
  }

  /* Pause on hover */
  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-item {
    flex-shrink: 0;
  }

  .phone-frame {
    width: 200px;
    height: 433px;
  }

  @media (min-width: 640px) {
    .phone-frame {
      width: 240px;
      height: 520px;
    }
  }

  @media (min-width: 1024px) {
    .phone-frame {
      width: 280px;
      height: 607px;
    }
  }
</style>
